---
import { getEntries, getEntry, render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortalMeta from '../components/portal/PortalMeta.astro';
import Backlinks from '../components/portal/Backlinks.astro';
import CopyCode from '../components/CopyCode.astro';
import Video from '../components/Video.astro';
import {
  backlinks,
  entryUrl,
  getPortal,
  lastUpdated,
  related,
  type Entry,
} from '../lib/portal';
import { AUTHOR_NAME, SECTIONS, discussUrl, historyUrl } from '../site';

export async function getStaticPaths() {
  const portal = await getPortal();
  const inbound = backlinks(portal);
  return portal.map((entry) => {
    const linkedFrom = inbound.get(entry.id) ?? [];
    return {
      params: { slug: entry.id },
      props: { entry, linkedFrom, nearby: related(entry, portal, linkedFrom) },
    };
  });
}

interface Props {
  entry: Entry;
  linkedFrom: Entry[];
  nearby: Entry[];
}
const { entry, linkedFrom, nearby } = Astro.props;
const { Content, headings } = await render(entry);
const topics = await getEntries(entry.data.topics);
// reference('series') transforms the frontmatter ID into { collection, id }.
const series = entry.data.series
  ? await getEntry(entry.data.series.id)
  : undefined;
const og = entry.data.cover
  ? await getImage({
      src: entry.data.cover.src,
      width: 1200,
      height: 630,
      format: 'jpg',
    })
  : undefined;
const url = new URL(entryUrl(entry), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.created.toISOString(),
  dateModified: lastUpdated(entry).toISOString(),
  mainEntityOfPage: url,
  keywords: topics.map((t) => t.data.title).join(', '),
  ...(og ? { image: new URL(og.src, Astro.site).href } : {}),
  author: { '@type': 'Person', name: AUTHOR_NAME },
};
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const section = SECTIONS[entry.data.type];
const seriesLabel =
  series && `${series.data.title}, part ${entry.data.series!.part}`;
const hasCode = /^ {0,3}(?:`{3,}|~{3,})/m.test(entry.body ?? ''); // only entries with code include the copy button
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={entry.data.canonicalUrl}
  ogImage={og?.src}
  jsonLd={jsonLd}
>
  <article class="entry-prose" data-pagefind-body>
    <header>
      <p class="entry-prose__kicker">
        <a href={`/${section.path}/`} data-pagefind-filter="section">
          {section.label}
        </a>
        {series && <a href={`/series/${series.id}/`}>{seriesLabel}</a>}
      </p>
      <h1>{entry.data.title}</h1>
      <PortalMeta entry={entry} topics={topics} />
    </header>
    <p class="lede">{entry.data.description}</p>
    {entry.data.cover && (
      <Image
        src={entry.data.cover.src}
        alt={entry.data.cover.alt}
        widths={[640, 960, 1200]}
        sizes="(max-width: 760px) 100vw, 760px"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    )}
    {entry.data.epistemic && (
      <blockquote>
        <p>
          <strong>Epistemic note.</strong> {entry.data.epistemic}
        </p>
      </blockquote>
    )}
    {entry.data.source && (
      <p>
        Source: <a href={entry.data.source}>{entry.data.source}</a>
      </p>
    )}
    {entry.data.video && (
      <Video id={entry.data.video} title={entry.data.title} />
    )}
    {toc.length > 1 && (
      <nav aria-label="On this page" data-pagefind-ignore>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <Content />
    {hasCode && <CopyCode />}
  </article>
  <aside
    class="entry-connections"
    aria-label="Connections"
    data-pagefind-ignore
  >
    <Backlinks title="Linked from" entries={linkedFrom} />
    <Backlinks title="Growing nearby" entries={nearby} />
    <ul class="l-inline-list">
      <li>
        <a href={historyUrl(entry.id)}>See how this grew</a>
      </li>
      <li>
        <a href={discussUrl(entry.data.title)}>Discuss on GitHub</a>
      </li>
    </ul>
  </aside>
</BaseLayout>

<style>
  @import '../styles/layers.css';

  @layer components {
    .entry-prose,
    .entry-connections {
      max-inline-size: var(--measure);
      margin-inline: auto;
    }
    .entry-prose {
      padding-block-start: clamp(var(--space-5), 6vw, 5rem);
      overflow-wrap: break-word;
    }
    .entry-prose :global(header) {
      margin-block-end: var(--space-4);
      padding-block-end: var(--space-4);
      border-block-end: 1px solid var(--line);
    }
    .entry-prose :global(h1) {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      line-height: 1.12;
    }
    .entry-prose :global(nav[aria-label='On this page']) {
      background: var(--panel);
      border-radius: var(--radius-card);
      padding: var(--space-2) var(--space-3);
      margin-block: var(--space-4);
      font-size: 0.85rem;
    }
    .entry-prose :global(nav li + li) {
      margin-block-start: var(--space-1);
    }
    .entry-prose :global(h2) {
      margin-block-start: 2em;
    }
    .entry-prose :global(h3) {
      margin-block-start: 1.7em;
    }
    .entry-prose :global(img) {
      display: block;
      max-width: 100%;
      height: auto;
    }
    .entry-prose__kicker {
      font: 0.8rem var(--font-ui);
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
    }
    .entry-prose :global(blockquote) {
      border-inline-start: 3px solid var(--accent);
      background: var(--panel);
      padding: var(--space-1) var(--space-3);
      margin-inline: 0;
    }
    .entry-prose :global(:where(code, kbd, pre)) {
      font-family: var(--font-code);
    }
    .entry-prose :global(pre) {
      overflow-x: auto;
      padding: 1.2rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-control);
      font-size: 0.85rem;
    }
    .entry-prose :global(.astro-code),
    .entry-prose :global(.astro-code span) {
      color: light-dark(var(--shiki-light), var(--shiki-dark));
      background-color: light-dark(var(--shiki-light-bg), var(--shiki-dark-bg));
    }
    .entry-prose :global(table) {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
    }
    .entry-prose :global(th),
    .entry-prose :global(td) {
      padding: 0.5em 0.8em;
      border: 1px solid var(--line);
      text-align: start;
    }
    .entry-connections {
      border-block-start: 1px solid var(--line);
      margin-block-start: var(--space-xl);
      padding-block-start: var(--space-m);
    }
    .entry-connections :global(section) {
      margin-block-end: var(--space-4);
    }

    /* Preserve contrast for Shiki comments in both themes. */
    .entry-prose :global(.astro-code span[style*='--shiki-light:#6A737D']) {
      color: var(--muted);
    }
  }
</style>
