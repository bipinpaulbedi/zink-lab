---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This path does not lead to an entry. Find your way back through the topic map."
  noindex
>
  <header class="page-intro">
    <p class="eyebrow">404 · An unmarked path</p>
    <h1>Nothing growing here. Yet.</h1>
    <p class="lede">
      This page could not be found. There are other paths worth following.
    </p>
    <p>
      <a href="/topics/">Explore the topic map</a> or{' '}
      <a href="/search/">search the portal</a>.
    </p>
  </header>
</BaseLayout>
