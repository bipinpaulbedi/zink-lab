---
interface Props {
  book: {
    id: string;
    title: string;
    author: string;
    rating: number;
    dateRead: string | null;
  };
  number: number;
}
const { book, number } = Astro.props;
const dateLabel = (date: string) =>
  new Intl.DateTimeFormat('en-AU', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(date));
---

<li class="book">
  <a class="book__link" href={`https://www.goodreads.com/book/show/${book.id}`}>
    <div class="book__cover">
      <span class="book__number" aria-hidden="true">
        {String(number).padStart(2, '0')}
      </span>
      <h3 class="book__cover-title">{book.title}</h3>
      <span class="book__cover-author">{book.author}</span>
    </div>
  </a>
  <p class="book__rating">
    {book.rating > 0 ? (
      <>
        <span class="book__stars" aria-hidden="true">
          {'★'.repeat(book.rating)}
          {'☆'.repeat(5 - book.rating)}
        </span>
        <span class="u-small">My rating: {book.rating}/5</span>
      </>
    ) : (
      <span class="u-small">Not rated</span>
    )}
  </p>
  {book.dateRead && (
    <p class="book__date u-small">
      Finished <time datetime={book.dateRead}>{dateLabel(book.dateRead)}</time>
    </p>
  )}
</li>

<style>
  @import '../styles/layers.css';

  @layer components {
    .book {
      min-width: 0;
    }
    .book__link {
      display: block;
      text-decoration: none;
    }
    .book__cover {
      display: grid;
      grid-template-rows: auto 1fr auto;
      height: 26rem;
      padding: var(--space-3);
      border: 1px solid var(--line);
      border-inline-start: 6px double var(--line);
      background: var(--panel);
      color: var(--text);
    }
    .book:nth-child(even) .book__cover {
      background: var(--surface);
    }
    .book__number {
      color: var(--accent);
      font: 0.75rem var(--font-code);
    }
    .book__cover-title {
      align-self: center;
      font: 1.35rem/1.2 var(--font-editorial);
      overflow-wrap: anywhere;
      margin-block: var(--space-3);
    }
    .book__cover-author {
      border-block-start: 1px solid var(--line);
      padding-block-start: var(--space-2);
      font: 0.75rem/1.5 var(--font-ui);
    }
    .book__link:hover .book__cover {
      border-color: var(--accent);
    }
    .book__rating {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem var(--space-1);
      align-items: center;
      margin-block: var(--space-1) 0;
    }
    .book__stars {
      color: var(--accent);
      letter-spacing: 0.08em;
    }
    .book__date {
      color: var(--muted);
      margin-block: 0.25rem 0;
    }
  }
</style>
